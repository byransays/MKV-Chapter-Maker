#!/bin/bash
#set -x


# Default Black Detect Duration in Seconds
value=".5"

# Minimum gap between chapters in seconds
Min_Chap=60

# Never create a chapter within this many seconds of the end of the video (avoids a chapter at end credits)
End_Threshold=60

# Default detection method: black | silence | scene
method="black"


# Start Time For Processing Script Elapsed Run Time (dont change this)
SECONDS=0


# Text Colors
BoRed=$(tput bold; tput setaf 1)
Bogreen=$(tput bold; tput setaf 28)
green=$(tput setaf 28)
purple=$(tput setaf 128)
brown=$(tput setaf 130)
yellow=$(tput setaf 226)
red=$(tput setaf 1)
white=$(tput setaf 15)
blue=$(tput setaf 21)
pink=$(tput setaf 200)
Lblue=$(tput setaf 117)
orange=$(tput setaf 166)
Lorange=$(tput setaf 215)
reset=$(tput sgr0)
invis=$(tput civis)
norm=$(tput cnorm)

# ── Usage ──────────────────────────────────────────────────────────────────────
usage() {
    printf "%b\n" "${white}
Usage:  FFchap [OPTIONS] <file.mkv>

Options:
  -s <seconds>   Detect duration threshold  (default: ${value}s)
  -m <method>    Detection method: black | silence | scene  (default: black)
  -h             Show this help

Detection methods:
  black    Detect black frames  (best for commercial-stripped TV shows)
  silence  Detect silent passages
  scene    Detect scene changes via FFmpeg scdet filter

Examples:
  FFchap \"Show - S01E01.mkv\"
  FFchap -s 1.5 \"Show - S01E01.mkv\"
  FFchap -m silence -s 1.0 \"Show - S01E01.mkv\"
  FFchap -m scene \"Show - S01E01.mkv\"
${reset}"
    exit 0
}

# ── Option Parsing ─────────────────────────────────────────────────────────────
while getopts ":s:m:h" opt; do
    case $opt in
        s) value="$OPTARG" ;;
        m) method="$OPTARG" ;;
        h) usage ;;
        \?) printf "%b\n" "${red}Invalid option: -$OPTARG${reset}" >&2; exit 1 ;;
        :)  printf "%b\n" "${red}Option -$OPTARG requires an argument.${reset}" >&2; exit 1 ;;
    esac
done
shift "$((OPTIND - 1))"

filename="$1"

# ── Input Validation ───────────────────────────────────────────────────────────
if [[ -z "$filename" ]]; then
    printf "%b\n" "${red}Error: no input file specified.${reset}" >&2
    usage
fi

if [[ ! -f "$filename" ]]; then
    printf "%b\n" "${red}Error: file not found: ${filename}${reset}" >&2
    exit 1
fi

if [[ "${filename,,}" != *.mkv ]]; then
    printf "%b\n" "${orange}Warning: file does not appear to be an MKV. mkvpropedit may fail.${reset}"
fi

if [[ "$method" != "black" && "$method" != "silence" && "$method" != "scene" ]]; then
    printf "%b\n" "${red}Error: unknown method '${method}'. Use: black | silence | scene${reset}" >&2
    exit 1
fi


# ── Requirements Check ────────────────────────────────────────────────────────
REQUIRES="ffmpeg ffprobe mkvpropedit bc"

Dep_Check() {
    for tool in ${REQUIRES}; do
        if ! command -v "${tool}" &>/dev/null; then
            printf "%b\n" "${red}Error: '${tool}' is not installed or not in PATH.${reset}" >&2
            exit 1
        fi
    done
}

# ── Signal Handling ────────────────────────────────────────────────────────────
Control_C() {
    tput el1
    printf "%b\n" "${orange}  *** CTRL+C Detected — cleaning up ***${reset}"
    printf "%b" "${reset}${norm}"
    exit 130
}
trap Control_C SIGINT

# ── Temp Directory (auto-cleaned on exit) ──────────────────────────────────────
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"; printf "%b" "${norm}"' EXIT

times_raw="$tmpdir/times_raw.log"
times_filtered="$tmpdir/times_filtered.log"
chapters_txt="$tmpdir/Chapters.txt"
chapters_final="$tmpdir/Chapters-Final.txt"

# ── Helpers ────────────────────────────────────────────────────────────────────
Convert_Seconds() {
    local H M S
    H=$(bc <<< "${1}/3600")
    M=$(bc <<< "(${1}%3600)/60")
    S=$(bc <<< "${1}%60")
    printf "%02d:%02d:%05.3f\n" "$H" "$M" "$S"
}

Spinner() {
    printf "%b" "${Lblue}"
    local pid=$1 delay=1.25 spinstr='|/-\'
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep "$delay"
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

# ── Chapter Generation ────────────────────────────────────────────────────────
Chapter_Gen() {
    printf "%b\n" "${pink}${filename##*/}${reset}"

    case "$method" in
        black)
            printf "%b" "${green}Detecting black frames (threshold: ${value}s)........Wait${invis}"
            ffmpeg -i "${filename}" \
                -vf "blackdetect=d=${value}:pix_th=0.1:pic_th=0.95" \
                -an -f null - 2>&1 \
                | grep -Pio '(?<=black_end:)[0-9.]+(?= black_duration)' \
                > "$times_raw" &
            ;;
        silence)
            printf "%b" "${green}Detecting silence (threshold: ${value}s)........Wait${invis}"
            ffmpeg -i "${filename}" \
                -af "silencedetect=n=-50dB:d=${value}" \
                -vn -f null - 2>&1 \
                | grep -Pio '(?<=silence_end: )[0-9.]+(?= \|)' \
                > "$times_raw" &
            ;;
        scene)
            printf "%b" "${green}Detecting scene changes........Wait${invis}"
            ffmpeg -v info \
                -f lavfi -i "movie=${filename},scdet=s=1:t=20" \
                -f null - 2>&1 \
                | grep -Pio '(?<=lavfi.scd.time: )[0-9.]+' \
                > "$times_raw" &
            ;;
    esac

    Spinner $!
    printf "%b\n" "${reset}${norm}"

    if [[ ! -s "$times_raw" ]]; then
        printf "%b\n" "${red}No detection events found. Try a smaller -s value or a different -m method.${reset}" >&2
        exit 1
    fi

    # Filter: drop chapters shorter than Min_Chap seconds apart (if Min_Chap > 0)
    if (( Min_Chap > 0 )); then
        mapfile -t float < "$times_raw"
        local prev=0
        > "$times_filtered"
        for ts in "${float[@]}"; do
            local gap
            gap=$(bc <<< "${ts} - ${prev}")
            if (( ${gap%.*} >= Min_Chap )); then
                printf "%s\n" "$ts" >> "$times_filtered"
                prev="$ts"
            fi
        done
    else
        cp "$times_raw" "$times_filtered"
    fi
    if [[ ! -s "$times_filtered" ]]; then
        printf "%b\n" "${orange}No detection events found after Min_Chap filtering. Try lowering Min_Chap or using a different detection method.${reset}"
        exit 1
    fi

    # Get video duration so we can exclude chapters too close to the end
    local duration
    duration=$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "${filename}")

    # Build chapter timestamp file (chapter 1 always starts at 00:00:00)
    # Skip any timestamp within End_Threshold seconds of the end (detection artifact)
    printf "00:00:00.000\n" > "$chapters_txt"
    while read -r ts; do
        local gap_to_end
        gap_to_end=$(bc <<< "${duration} - ${ts}")
        # Use End_Threshold, not Min_Chap, for end-of-file filtering
        if (( $(echo "$gap_to_end >= $End_Threshold" | bc -l) )); then
            Convert_Seconds "$ts" >> "$chapters_txt"
        else
            printf "%b\n" "${orange}Skipping end-of-video timestamp $(Convert_Seconds "$ts") (only ${gap_to_end}s before end)${reset}"
        fi
    done < "$times_filtered"

    # Guard: if only the 00:00:00 anchor remains, nothing useful was found
    local total
    total=$(wc -l < "$chapters_txt")
    if (( total < 2 )); then
        printf "%b\n" "${orange}No chapters remain after filtering. All events were too close to the end of the video.${reset}"
        exit 1
    fi

    # Format as OGM chapter file
    local idx=0
    mapfile -t chapter_marker < <(seq -f "%02g" 1 "$total")

    while read -r ts; do
        printf "CHAPTER%s=%s\n"             "${chapter_marker[$idx]}" "$ts"                    >> "$chapters_final"
        printf "CHAPTER%sNAME=Chapter %s\n" "${chapter_marker[$idx]}" "${chapter_marker[$idx]}" >> "$chapters_final"
        (( idx++ ))
    done < "$chapters_txt"

    printf "%b" "${Lblue}"
    cat "$chapters_final"
    printf "%b\n" "${orange}Removing existing chapters (if present)...${reset}"
    mkvpropedit -c '' "${filename}"
    printf "%b\n" "${green}Inserting ${total} new chapters...${reset}"
    mkvpropedit -c "$chapters_final" "${filename}"

    local ELAPSED
    ELAPSED="Processing Time: $(( SECONDS / 3600 )) hrs $(( (SECONDS / 60) % 60 )) min $(( SECONDS % 60 )) sec"
    printf "%b\n" "${yellow}${ELAPSED}${reset}"
}

# ── Main ──────────────────────────────────────────────────────────────────────
Dep_Check
Chapter_Gen
